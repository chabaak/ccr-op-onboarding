{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "index.schema.json",
  "title": "scenario index — 런타임 팩 목록과 역할",
  "description": "부트와 선택 화면이 읽는 팩 목록. role/order/difficulty는 meta.json이 아니라 이 매니페스트가 소유한다.",
  "type": "object",
  "required": ["packs"],
  "additionalProperties": false,
  "properties": {
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "display_name", "role", "order", "difficulty"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["tutorial", "practice"] },
          "order": { "type": "integer", "minimum": 0 },
          "difficulty": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
