{
  "name": "ccr-op-onboarding",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file=.env.local tools/local-api-proxy.mjs",
    "check": "tsc -p config/tsconfig.core.json && tsc && npm run typecheck:test && npm run datapack:check && npm run datapack:lint:all && npm run test:shared",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "datapack:types": "node authoring/generate-datapack-types.mjs",
    "datapack:check": "node authoring/generate-datapack-types.mjs --check",
    "datapack:compile": "node authoring/compile-datapack.mjs",
    "datapack:lint": "node --experimental-strip-types authoring/lint-datapack.mjs",
    "datapack:lint:all": "node authoring/lint-all-packs.mjs",
    "audio:build": "node tools/audio/build-audio-pack.mjs",
    "audio:check": "node tools/audio/build-audio-pack.mjs --check",
    "audio:manifest": "node tools/audio/build-audio-pack.mjs --manifest",
    "audio:table": "node tools/audio/build-audio-pack.mjs --table",
    "probe": "node tools/probe/run.mjs",
    "probe:selftest": "node tools/probe/lib/selftest.mjs",
    "smoke:local-api": "node tools/local-api-smoke.mjs",
    "drive:beat": "node tools/driver/drive-beat.mjs",
    "test": "vitest run --config config/vitest.config.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "typecheck:test": "tsc -p config/tsconfig.test.json",
    "test:shared": "node --test --experimental-strip-types \"tools/tests/*.mjs\""
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
